# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / FRONTEND_URL: Public URL of your Gulfaro frontend (Hostinger domain https://www.gulfaro.net)
# AI Studio automatically injects APP_URL in preview; set FRONTEND_URL & CORS_ORIGIN on Render.
APP_URL="MY_APP_URL"
FRONTEND_URL="https://www.gulfaro.net"
CORS_ORIGIN="https://gulfaro.net,https://www.gulfaro.net"

# Frontend-only build variable (optional if already set in public/gulfaro-config.js):
VITE_API_BASE_URL="https://gulfaro.onrender.com"

# =========================================================================
# Official Hostinger SMTP Production Email Configuration (info@gulfaro.net)
# =========================================================================
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@gulfaro.net"
SMTP_PASS="replace-with-hostinger-mailbox-password"
EMAIL_FROM="info@gulfaro.net"
EMAIL_FROM_NAME="Gulfaro"

# Legacy optional Resend fallback (only used when Hostinger SMTP is not configured)
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="Gulfaro <info@gulfaro.net>"

# =========================================================================
# Supabase PostgreSQL Production Database (Server-Only Secrets on Render)
# NEVER expose these with a VITE_ prefix or in frontend source code.
# =========================================================================
DB_BACKEND="postgres"

# Pooled Supabase Transaction/Session Connection String (port 6543 or 5432, SSL required)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# Direct non-pooled connection string (port 5432) for schema migrations / backups
DIRECT_DATABASE_URL="postgresql://postgres:[DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Enforce strict TLS CA verification in production if custom CA or strict SSL desired
PG_SSL_STRICT="false"

# =========================================================================
# Custom Authentication & Super Admin Secrets (Server-Only on Render)
# =========================================================================
JWT_SECRET="replace-with-64-char-random-hex-secret"
SUPER_ADMIN_JWT_SECRET="replace-with-distinct-64-char-random-hex-secret"
# Initial bootstrap password for owner Super Admin account ("Haroon555") if not yet seeded
# SUPER_ADMIN_INITIAL_PASSWORD="change-me-after-first-login"
