# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / FRONTEND_URL: Public URL of your Gulfaro frontend (e.g. Hostinger domain https://gulfaro.com)
# AI Studio automatically injects APP_URL in preview; set FRONTEND_URL & CORS_ORIGIN on Render.
APP_URL="MY_APP_URL"
FRONTEND_URL="https://gulfaro.com"
CORS_ORIGIN="https://gulfaro.com,https://www.gulfaro.com"

# Frontend-only build variable (set during Hostinger frontend build, leave empty locally):
# VITE_API_BASE_URL="https://your-gulfaro-backend.onrender.com"

# =========================================================================
# Resend API Production Email Configuration (Deliver to all email providers)
# =========================================================================
# 1. RESEND_API_KEY: Your production API key from https://resend.com/api-keys
RESEND_API_KEY="re_123456789"

# 2. RESEND_FROM_EMAIL: Sender address using your verified domain on Resend
#    e.g. "Gulfaro Security <security@gulfaro.com>" or "Gulfaro <noreply@yourdomain.com>"
#    Note: "onboarding@resend.dev" can be used for initial testing to your own account
RESEND_FROM_EMAIL="Gulfaro Security <security@gulfaro.com>"

# Optional SMTP fallback configuration
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="admingulfaro@gmail.com"
# SMTP_PASS="your-app-password"
# EMAIL_FROM="Gulfaro Official <admingulfaro@gmail.com>"

# =========================================================================
# Supabase PostgreSQL Production Database (Server-Only Secrets for Cloud Run)
# NEVER expose these with a VITE_ prefix or in frontend source code.
# =========================================================================
# Storage backend mode:
#   - Omit or set to "postgres" when DATABASE_URL is configured
#   - Set to "json" for instant rollback to /data/*.json file storage
DB_BACKEND="postgres"

# Pooled Supabase Transaction/Session Connection String (port 6543 or 5432, SSL required)
# Store in Google Cloud Secret Manager and inject into Cloud Run as DATABASE_URL
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# Direct non-pooled connection string (port 5432) for schema migrations / backups
DIRECT_DATABASE_URL="postgresql://postgres:[DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Enforce strict TLS CA verification in production if custom CA or strict SSL desired
PG_SSL_STRICT="false"

# =========================================================================
# Custom Authentication & Super Admin Secrets (Server-Only on Cloud Run)
# =========================================================================
JWT_SECRET="replace-with-64-char-random-hex-secret"
SUPER_ADMIN_JWT_SECRET="replace-with-distinct-64-char-random-hex-secret"
# Initial bootstrap password for owner Super Admin account ("Haroon555") if not yet seeded
# SUPER_ADMIN_INITIAL_PASSWORD="change-me-after-first-login"

